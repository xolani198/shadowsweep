# ─────────────────────────────────────────────────────────────────────────────
# ShadowSweep environment variables
#
# Copy this file to `.env.local` for local development and set the values in the
# Vercel dashboard for deployments. Variables WITHOUT the NEXT_PUBLIC_ prefix are
# server-only secrets and are never shipped to the browser. NEVER put a secret
# behind a NEXT_PUBLIC_ name — those are inlined into the client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: session signing ────────────────────────────────────────────────
# HMAC key used to sign and verify the session cookie. Generate 32+ random bytes:
#   openssl rand -base64 32
# Without this, the app treats every request as unauthenticated (fails closed).
SESSION_SECRET=

# ── Credential sign-in (optional) ────────────────────────────────────────────
# A single admin account for email/password sign-in. Leave blank to disable the
# email/password form (the demo SSO buttons still work in demo mode).
# Use a strong, unique password — it is compared in constant time.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=

# ── Demo mode (public client flag) ───────────────────────────────────────────
# "true" (default): serve the bundled demo dataset and let /dashboard be browsed
# without a login (a demo session is auto-issued). Set to "false" on a real
# tenant to require sign-in and start from an empty, integration-ready state.
NEXT_PUBLIC_DEMO_MODE=true

# ── Site URL (public) ────────────────────────────────────────────────────────
# Absolute base URL, used for canonical/OpenGraph metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://shadowsweep-rho.vercel.app

# ── Error monitoring (optional) ──────────────────────────────────────────────
# If set, unhandled server-side errors are POSTed here as structured JSON so you
# are alerted in production (e.g. a Slack incoming webhook or a Sentry tunnel).
# Leave blank to log to the console only. Server-only; never NEXT_PUBLIC_.
MONITORING_WEBHOOK_URL=

# ── Stripe (payments) ────────────────────────────────────────────────────────
# Use TEST-mode keys (sk_test_… / whsec_…) until you are ready to go live; the
# app flips to live by swapping these for live values. Billing degrades to a
# clear "not configured" state when these are unset, so the app still runs.
#
# Secret API key (Dashboard → Developers → API keys).
STRIPE_SECRET_KEY=
# Webhook signing secret (Dashboard → Developers → Webhooks → your endpoint).
STRIPE_WEBHOOK_SECRET=
# Optional: pin a Stripe API version (otherwise the account default is used).
STRIPE_API_VERSION=
# Recurring Price IDs (Dashboard → Product catalog). One per plan + interval.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
